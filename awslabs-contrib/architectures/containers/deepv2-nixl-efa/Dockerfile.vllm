# Copyright Amazon.com, Inc. or its affiliates. All Rights Reserved.
# SPDX-License-Identifier: MIT-0
#
# vLLM v0.33.0 + DeepEP V2 (NCCL GIN / EFA-GDA) + NIXL v1.5.2 (LIBFABRIC over EFA) image.
#
# Built ON TOP of vLLM's own AWS EFA image, vllm/vllm-openai:v0.33.0-x86_64-efa
# (vLLM's docker/Dockerfile.efa). That image already carries, and this file does NOT
# rebuild:
#   - vLLM 0.33.0, torch 2.14.0+cu130, Python 3.12, FlashInfer 0.7.2.post1 + kernels
#   - NCCL 2.31.2 (GIN API, nvidia-nccl-cu13 wheel)
#   - EFA installer 1.51.0: libfabric 2.7.0 (/opt/amazon/efa), aws-ofi-nccl 1.22.0
#     (/opt/amazon/ofi-nccl, NCCL_NET_PLUGIN=ofi / NCCL_TUNER_PLUGIN=ofi), hwloc
#   - GDRCopy 2.5.1 (NVIDIA libgdrapi deb, on the loader path)
#   - NIXL 1.5.0 wheel (nixl-cu13) with its LIBFABRIC plugin linked to the EFA libfabric
#   - Mooncake (EFA wheel), LMCache, DeepEP V2 2.1.0+874779c
#
# This file adds only what that image lacks:
#   0. NIXL 1.5.2 wheels in place of 1.5.0. On libfabric 2.7 (EFA 1.51) NIXL 1.5.0 WRITE
#      fails: an unlocked endpoint race (ai-dynamo/nixl#2308) and unsolicited write recv
#      left on by the wheel (#2494). 1.5.2 carries both fixes. Seen as GPU-0 aborts in the
#      8-GPU WRITE test and a dead decode engine in vLLM 1P1D on the 1.5.0 wheel.
#   1. DeepEP V2 rebuilt at amazon-contributing/DeepEP d75f22a5 (9 EFA fixes newer than
#      the base's 874779c: GIN flush before exit, gin.flush timeout, proxy ring wait,
#      hybrid dispatch races) and for sm_120 (g7e) too; the base builds sm_90a/100a/103a.
#   2. NIXL's C++ test binaries (LIBFABRIC only; no UCX) under /opt/nixl-tests, built
#      from the same NIXL v1.5.2 commit in a throw-away stage. Run them through
#      `nixl-test <binary>`, which points them at /opt/nixl; vLLM keeps using the wheel.
#   3. The DeepEP V2 EFA-GDA runtime selection (NCCL_GIN_TYPE=5, FI_PROVIDER=efa).
#   4. Build gates: NCCL GIN symbol, NCCL plugins, GDRCopy, LIBFABRIC -> EFA libfabric,
#      DeepEP V2 API + SASS for every arch, NIXL tests resolve, torch/NCCL/vLLM unchanged.
#
# EFA does not support UCX, so every NIXL path here is LIBFABRIC. The base's NIXL wheel
# still ships a UCX plugin; nothing in this image selects it.
#
# Build context: Dockerfile.vllm, setup_deepep_gin.sh, build-requirements.txt
#   DOCKER_BUILDKIT=1 docker build --progress=plain -f Dockerfile.vllm \
#     -t <registry>/<repo>/nixl-deepep-efa:vllm0.33.0-efa .
#
# Pinning: the base image is pinned by digest, git sources by full commit SHA, and the
# NIXL build tools by build-requirements.txt (--require-hashes).

# vllm/vllm-openai:v0.33.0-x86_64-efa (published 2026-11-02, vLLM commit 4ba787ec).
ARG BASE_IMAGE=docker.io/vllm/vllm-openai@sha256:5fc20aa179d3f7f83aa4a8b66473edf80582d865c62b630e49a207c76b9a0886

# CUDA architectures for the code this file compiles (DeepEP V2, NIXL tests).
#   9.0 = H100/H200, 10.0 = B200/B300/GB200, 10.3 = B300/GB300, 12.0 = RTX PRO 6000 (g7e)
ARG TORCH_CUDA_ARCH_LIST="9.0;10.0;10.3;12.0"

# NIXL v1.5.2 = e72c52c (2026-10-28). The test stage builds this commit; the final stage
# swaps the base's 1.5.0 wheels for the 1.5.2 wheels below (PyPI, sha256-pinned).
ARG NIXL_VERSION=1.5.2
ARG NIXL_CU13_WHEEL_SHA256=591eda3f14b72769590cd71b6b46fc5e483ef1b5a90a29a8ff464310c9cf6af2
ARG NIXL_META_WHEEL_SHA256=e4ef5e16f60be11622030e23333387bd73101102fc9f62efa1c99021d51550a6
ARG NIXL_REF="v1.5.2"
ARG NIXL_COMMIT=e72c52c78478d2e1ca9e9c57b872114e113ad767

# DeepEP V2 (amazon-contributing fork; setup_deepep_gin.sh clones only that repo).
ARG DEEPEP_REF=d75f22a5e07c95eb0bae94ad6445a5009c06c886

# Versions the base ships; the gates fail the build if a step here moves them.
ARG VLLM_VERSION=0.33.0
ARG TORCH_VERSION=2.14.0
ARG NCCL_VERSION=2.31.2

# ===========================================================================
# Stage 1 (discarded): NIXL v1.5.2 C++ tests, LIBFABRIC plugin only.
# ===========================================================================
FROM ${BASE_IMAGE} AS nixl-tests-build
ARG NIXL_REF
ARG NIXL_COMMIT
ARG TORCH_CUDA_ARCH_LIST
ENV DEBIAN_FRONTEND=noninteractive

# hwloc headers (LIBFABRIC plugin) and pkg-config; libnuma-dev, the EFA libfabric
# headers (/opt/amazon/efa/include) and nvcc are already in the base.
RUN apt-get update -y \
    && apt-get install -y --no-install-recommends libhwloc-dev pkg-config \
    && rm -rf /var/lib/apt/lists/*
# meson / ninja / pybind11 at hashed versions. Only this stage sees them.
RUN --mount=type=bind,source=build-requirements.txt,target=/tmp/build-requirements.txt \
    pip3 install --no-cache-dir --require-hashes -r /tmp/build-requirements.txt

ENV PKG_CONFIG_PATH="/opt/amazon/efa/lib/pkgconfig:/opt/amazon/efa/lib64/pkgconfig"
# - enable_plugins=LIBFABRIC: the only backend that runs on EFA. A requested plugin
#   that cannot be built is a meson ERROR, so a missing libfabric fails loudly.
# - no ucx_path and no build_nixl_ep: NIXL EP hard-codes the UCX backend.
# - buildtype=debugoptimized: NIXL compiles test/ only when buildtype != release.
# - werror=false: GCC raises a false -Wmaybe-uninitialized in the EFA fi_domain.h.
# - nixl_cuda_arch_list is COMMA-separated, derived from TORCH_CUDA_ARCH_LIST.
# Tests kept: the LIBFABRIC ones and the backend-free ones. Dropped: nixl_test,
# agent_example, nixl_example (all hard-code createBackend("UCX")).
RUN set -e; \
    git clone https://github.com/ai-dynamo/nixl.git /tmp/nixl; \
    cd /tmp/nixl; \
    git checkout "${NIXL_COMMIT}"; \
    [ "$(git rev-parse "${NIXL_REF}^{commit}")" = "${NIXL_COMMIT}" ] \
        || { echo "FATAL: ${NIXL_REF} no longer points at ${NIXL_COMMIT}"; exit 1; }; \
    git submodule update --init --recursive; \
    ARCHS="$(echo "${TORCH_CUDA_ARCH_LIST}" | tr -d . | tr ';' ',')"; \
    meson setup /tmp/nixl/build \
        --prefix=/opt/nixl \
        --buildtype=debugoptimized \
        -Dwerror=false \
        -Dlibfabric_path=/opt/amazon/efa \
        -Dinstall_headers=false \
        -Dbuild_tests=true \
        -Denable_plugins=LIBFABRIC \
        -Dnixl_cuda_arch_list="${ARCHS}"; \
    ninja -C /tmp/nixl/build; \
    ninja -C /tmp/nixl/build install; \
    test -n "$(find /opt/nixl -name 'libplugin_LIBFABRIC.so')" \
        || { echo "FATAL: NIXL built without the LIBFABRIC plugin"; exit 1; }; \
    ! find /opt/nixl -name 'libplugin_UCX.so' | grep -q . \
        || { echo "FATAL: a UCX plugin was built"; exit 1; }; \
    mkdir -p /opt/nixl-tests; \
    for t in libfabric_topology_test rail_active_refcount_test desc_example \
             p2p_test serdes_test telemetry_reader; do \
        f="$(find /opt/nixl/bin /tmp/nixl/build -name "$t" -type f -perm -u+x | head -1)"; \
        [ -n "$f" ] || { echo "FATAL: NIXL test $t not built"; exit 1; }; \
        cp "$f" /opt/nixl-tests/; \
    done; \
    # libfabric_topology_test reads the per-instance topology files next to it.
    cp /opt/nixl/bin/*-topo.xml /opt/nixl-tests/ 2>/dev/null || true; \
    rm -rf /opt/nixl/bin /opt/nixl/include /tmp/nixl

# ===========================================================================
# Stage 2: the image.
# ===========================================================================
FROM ${BASE_IMAGE}
ARG TORCH_CUDA_ARCH_LIST
ARG DEEPEP_REF
ARG VLLM_VERSION
ARG TORCH_VERSION
ARG NCCL_VERSION

# --- NIXL tests -----------------------------------------------------------------
COPY --from=nixl-tests-build /opt/nixl /opt/nixl
COPY --from=nixl-tests-build /opt/nixl-tests /opt/nixl-tests
# The tests link /opt/nixl's libnixl; vLLM links the wheel's. Keep /opt/nixl off the
# global loader path so the two never mix, and point only the tests at it.
RUN printf '%s\n' '#!/bin/sh' \
        '# Run a NIXL test from /opt/nixl-tests against /opt/nixl (LIBFABRIC plugin only).' \
        'export LD_LIBRARY_PATH="/opt/nixl/lib/x86_64-linux-gnu:/opt/nixl/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"' \
        'export NIXL_PLUGIN_DIR=/opt/nixl/lib/x86_64-linux-gnu/plugins' \
        'case "$1" in */*) exec "$@" ;; *) b="$1"; shift; exec "/opt/nixl-tests/$b" "$@" ;; esac' \
        > /usr/local/bin/nixl-test \
    && chmod 755 /usr/local/bin/nixl-test

# --- NIXL 1.5.2 wheels for vLLM ---------------------------------------------------
# Replace the base's nixl-cu13 / nixl 1.5.0 with 1.5.2 (see item 0 in the header).
# --no-deps: their only deps are torch and numpy, already pinned by the base.
# vLLM 0.33.0's kv_connectors.txt names nixl==1.5.0; that pin is install-time only, and
# 1.5.2 is a patch release of the same API.
ARG NIXL_VERSION
ARG NIXL_CU13_WHEEL_SHA256
ARG NIXL_META_WHEEL_SHA256
RUN set -e; \
    printf '%s\n' \
        "nixl-cu13==${NIXL_VERSION} --hash=sha256:${NIXL_CU13_WHEEL_SHA256}" \
        "nixl==${NIXL_VERSION} --hash=sha256:${NIXL_META_WHEEL_SHA256}" > /tmp/nixl-req.txt; \
    pip3 install --no-deps --no-cache-dir --require-hashes --index-url https://pypi.org/simple \
        -r /tmp/nixl-req.txt; \
    rm -f /tmp/nixl-req.txt; \
    python3 -c "import sys; from importlib.metadata import version as v; \
c, m = v('nixl-cu13'), v('nixl'); print('nixl-cu13', c, '| nixl', m); \
sys.exit(0 if c == m == '${NIXL_VERSION}' else (print('FATAL: NIXL wheels not ${NIXL_VERSION}') or 1))"

# --- DeepEP V2 at the EFA-fixed pin -----------------------------------------------
# The base already has nvcc, git and the CUDA dev headers DeepEP needs (vLLM's
# Dockerfile.efa installs them). The runtime base sets no LIBRARY_PATH, so add the CUDA
# driver stubs to link libcuda without a GPU, and the NCCL root so -lnccl resolves.
RUN --mount=type=bind,source=setup_deepep_gin.sh,target=/tmp/setup_deepep_gin.sh \
    set -e; \
    NCCL_ROOT="$(python3 -c "import importlib.util, os; s = importlib.util.find_spec('nvidia.nccl'); print(list(s.submodule_search_locations)[0])")"; \
    test -f "${NCCL_ROOT}/lib/libnccl.so.2"; \
    ln -sf libnccl.so.2 "${NCCL_ROOT}/lib/libnccl.so"; \
    LIBRARY_PATH="${NCCL_ROOT}/lib:/usr/local/cuda/lib64/stubs:/usr/local/cuda/targets/x86_64-linux/lib/stubs${LIBRARY_PATH:+:$LIBRARY_PATH}" \
    TORCH_CUDA_ARCH_LIST="${TORCH_CUDA_ARCH_LIST}" \
        bash /tmp/setup_deepep_gin.sh \
            --deepep-ref "${DEEPEP_REF}" \
            --deepep-prefix /tmp/deepep \
            --nccl-root "${NCCL_ROOT}"; \
    rm -rf /tmp/deepep /root/.cache/pip

# --- Runtime selection --------------------------------------------------------------
# DeepEP V2 EFA-GDA = NCCL GIN type 5 over the EFA libfabric provider. The base already
# sets NCCL_NET_PLUGIN=ofi / NCCL_TUNER_PLUGIN=ofi (resolved via ld.so.conf.d).
# FI_EFA_USE_UNSOLICITED_WRITE_RECV=0: libfabric >= 2.0 turns unsolicited write recv on by
# default, and it can lose remote write completions under load. NIXL 1.5.2 also turns it
# off per endpoint; the env var covers every other libfabric user in the image too.
ENV FI_PROVIDER=efa \
    FI_EFA_USE_UNSOLICITED_WRITE_RECV=0 \
    NCCL_GIN_TYPE=5 \
    NVIDIA_GDRCOPY=enabled
# Do NOT set NIXL_ETCD_ENDPOINTS here: the NIXL wheel treats a set-but-empty value as an error
# ("Config parameter 'NIXL_ETCD_ENDPOINTS' needs non-empty value") and every nixl_agent(),
# including vLLM's NixlConnector, fails. Unset = no etcd, peers exchange metadata directly.

# --- License hygiene ------------------------------------------------------------
# The base image ships build cruft the license gate blocks; nothing at run time uses it:
#   - setuptools/_vendor/autocommand (LGPL-3.0) and pkg_resources/tests (my-test-package
#     fixture, no metadata), as in Dockerfile;
#   - software-properties-common (add-apt-repository) and the system-Python packages only
#     it pulls in: python3-apt (GPL), python3-gi / launchpadlib / lazr.* / wadllib (LGPL),
#     and blinker / pyparsing (no licence metadata) via oauthlib / httplib2. vLLM runs from
#     /usr/local/lib/python3.12/dist-packages and imports none of them.
RUN set -e; \
    for d in $(find /usr/local/lib /usr/lib -type d -path '*/setuptools/_vendor' 2>/dev/null); do \
        rm -rf "$d/autocommand" "$d"/autocommand-*.dist-info; \
    done; \
    for d in $(find /usr/local/lib /usr/lib -type d -path '*/pkg_resources/tests' 2>/dev/null); do \
        rm -rf "$d"; \
    done; \
    apt-get purge -y software-properties-common python3-software-properties python3-apt \
        python3-launchpadlib python3-lazr.restfulclient python3-lazr.uri python3-wadllib \
        python3-gi python3-oauthlib python3-blinker python3-httplib2 python3-pyparsing; \
    rm -rf /var/lib/apt/lists/*; \
    ! find /usr/local/lib /usr/lib -iname 'autocommand*' 2>/dev/null | grep -q . \
      && ! find /usr/local/lib /usr/lib -ipath '*my-test-package*' 2>/dev/null | grep -q . \
      && ! dpkg -l software-properties-common python3-apt python3-gi python3-launchpadlib 2>/dev/null | grep -q '^ii' \
      && echo "OK: autocommand, my-test-package and the apt-only Python packages removed" \
      || { echo "FATAL: license hygiene incomplete"; exit 1; }

# --- Gates (no GPU in the build; binary, loader and import level) -------------------
RUN set -e; \
    python3 -c "import sys; from importlib.metadata import version as v; \
vl, t, n = v('vllm'), v('torch'), v('nvidia-nccl-cu13'); \
print('vllm', vl, '| torch', t, '| nvidia-nccl-cu13', n); \
sys.exit(0 if vl == '${VLLM_VERSION}' and t.startswith('${TORCH_VERSION}+') and n == '${NCCL_VERSION}' \
         else (print('FATAL: vLLM, torch or NCCL moved') or 1))"; \
    SO="$(python3 -c "import importlib.util, os; s = importlib.util.find_spec('nvidia.nccl'); print(os.path.join(list(s.submodule_search_locations)[0], 'lib', 'libnccl.so.2'))")"; \
    nm -D "$SO" | grep -q ncclCommQueryProperties \
        && echo "OK: $SO exports the GIN symbol" || { echo "FATAL: NCCL lacks GIN"; exit 1; }; \
    ldconfig -p | grep -q '/opt/amazon/ofi-nccl/lib/libnccl-net-ofi.so$' \
        && ldconfig -p | grep -q '/opt/amazon/ofi-nccl/lib/libnccl-tuner-ofi.so$' \
        && echo "OK: aws-ofi-nccl net + tuner plugins on the loader path" \
        || { echo "FATAL: aws-ofi-nccl plugins not resolvable (NCCL would use sockets)"; exit 1; }; \
    ldconfig -p | grep -q 'libgdrapi.so.2' \
        && echo "OK: libgdrapi.so.2 (GDRCopy) on the loader path" \
        || { echo "FATAL: GDRCopy library missing"; exit 1; }; \
    P="$(python3 -c "import nixl_cu13, os, glob; d = os.path.dirname(os.path.dirname(nixl_cu13.__file__)); print(glob.glob(d + '/nixl_cu13.libs/nixl/libplugin_LIBFABRIC.so')[0])")"; \
    # The plugin's NIXL siblings (libnixl_common, libserdes) live in the wheel's
    # .nixl_cu13.mesonpy.libs, which nixl_cu13._bindings loads before the plugin at runtime;
    # libcuda.so.1 is the driver, injected at run time and absent in a GPU-less build.
    NF="$(LD_LIBRARY_PATH="$(dirname "$(dirname "$(dirname "$P")")")/.nixl_cu13.mesonpy.libs" ldd "$P" \
          | grep 'not found' | grep -v 'libcuda\.so\.1' || true)"; \
    ldd "$P" | grep -q 'libfabric.so.1 => /opt/amazon/efa/lib/' \
        && [ -z "$NF" ] \
        && echo "OK: vLLM's NIXL LIBFABRIC plugin uses the EFA libfabric ($P)" \
        || { echo "FATAL: $P does not resolve to the EFA libfabric"; ldd "$P"; exit 1; }; \
    for t in /opt/nixl-tests/*_test /opt/nixl-tests/desc_example /opt/nixl-tests/telemetry_reader; do \
        if LD_LIBRARY_PATH=/opt/nixl/lib/x86_64-linux-gnu:/opt/nixl/lib ldd "$t" | grep 'not found' | grep -qv 'libcuda\.so\.1'; then \
            echo "FATAL: $t has unresolved libraries"; exit 1; \
        fi; \
    done; \
    # Running the tests needs the GPU driver (libcuda.so.1), which a build does not have;
    # the pipeline runs them in a GPU pod.
    echo "OK: every NIXL test resolves its libraries (libcuda.so.1 comes from the driver at run time)"; \
    [ -z "${NIXL_ETCD_ENDPOINTS+x}" ] || [ -n "${NIXL_ETCD_ENDPOINTS}" ] \
        && echo "OK: NIXL_ETCD_ENDPOINTS is unset or non-empty (an empty value breaks nixl_agent)" \
        || { echo "FATAL: NIXL_ETCD_ENDPOINTS is set but empty"; exit 1; }; \
    python3 -c "import deep_ep, sys; \
ok = hasattr(deep_ep, 'ElasticBuffer'); print('deep_ep', deep_ep.__file__, 'ElasticBuffer:', ok); \
sys.exit(0 if ok else 1)"; \
    for f in $(python3 -c "import deep_ep, os, glob; print(' '.join(glob.glob(os.path.dirname(deep_ep.__file__) + '/_C*.so')))"); do \
        have=" $(cuobjdump --list-elf "$f" | grep -oE 'sm_[0-9]+' | sort -u | tr '\n' ' ')"; \
        for a in $(echo "${TORCH_CUDA_ARCH_LIST}" | tr ';' ' '); do \
            sm="sm_$(echo "$a" | tr -d .)"; \
            echo "$have" | grep -q " $sm " || { echo "FATAL: $f lacks $sm (has:$have)"; exit 1; }; \
        done; \
        echo "OK: $(basename "$f") has SASS for ${TORCH_CUDA_ARCH_LIST} (has:$have)"; \
    done

LABEL org.opencontainers.image.description="vLLM ${VLLM_VERSION} (vllm/vllm-openai:v0.33.0-x86_64-efa) + DeepEP V2 ${DEEPEP_REF} (NCCL GIN/EFA-GDA) + NIXL v1.5.2 LIBFABRIC tests; EFA installer 1.51.0; sm_90/sm_100/sm_103/sm_120"
LABEL vllm.version="${VLLM_VERSION}" \
      torch.version="${TORCH_VERSION}+cu130" \
      nixl.ref="v1.5.2" \
      deepep.ref="amazon-contributing/DeepEP@${DEEPEP_REF}" \
      efa.installer="1.51.0" \
      base.image="vllm/vllm-openai:v0.33.0-x86_64-efa@sha256:5fc20aa179d3f7f83aa4a8b66473edf80582d865c62b630e49a207c76b9a0886"
